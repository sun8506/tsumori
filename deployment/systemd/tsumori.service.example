[Unit]
Description=Tsumori web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tsumori
Group=tsumori
WorkingDirectory=/opt/tsumori
EnvironmentFile=/etc/tsumori/tsumori.env
ExecStart=/usr/bin/node /opt/tsumori/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tsumori

[Install]
WantedBy=multi-user.target
